PORT=3000

# В Docker: mongodb://root:example@mongo:27017/weblarek?authSource=admin
DB_ADDRESS=mongodb://127.0.0.1:27017/weblarek

UPLOAD_PATH=images
UPLOAD_PATH_TEMP=temp

# Источник, которому разрешены запросы с credentials
ORIGIN_ALLOW=http://localhost:5173

# Секреты обязательно заменить перед публикацией
AUTH_ACCESS_TOKEN_SECRET=change-me-access-secret
AUTH_REFRESH_TOKEN_SECRET=change-me-refresh-secret
CSRF_TOKEN_SECRET=change-me-csrf-secret

# Короткий access-токен ограничивает время жизни украденного токена
AUTH_ACCESS_TOKEN_EXPIRY=10m
AUTH_REFRESH_TOKEN_EXPIRY=7d

# Rate limiting: RATE_LIMIT_POINTS запросов за RATE_LIMIT_DURATION секунд
RATE_LIMITED=true
RATE_LIMIT_POINTS=40
RATE_LIMIT_DURATION=60

# Ограничения размеров пользовательских данных
BODY_LIMIT=100kb
UPLOAD_MIN_FILE_SIZE=2048
UPLOAD_MAX_FILE_SIZE=10485760
